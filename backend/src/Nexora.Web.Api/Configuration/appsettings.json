{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Nexora": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=NexoraDb;User Id=${DB_USER};Password=${DB_PASSWORD};TrustServerCertificate=True;",
    "Redis": "${REDIS_CONNECTION_STRING}"
  },
  "KeyVault": {
    "VaultUri": "https://${KEY_VAULT_NAME}.vault.azure.net/",
    "CurrentKeyId": "${CURRENT_KEY_ID}",
    "PreviousKeyIds": [
      "${PREVIOUS_KEY_ID_1}",
      "${PREVIOUS_KEY_ID_2}"
    ]
  },
  "Jwt": {
    "Issuer": "nexora-api",
    "Audience": "nexora-clients",
    "SecretKey": "${JWT_SECRET}",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30
  },
  "Tenancy": {
    "Mode": "Subdomain",
    "HeaderName": "X-Tenant-ID",
    "DefaultTenantId": 1,
    "EnableMultiTenancy": true,
    "TenantResolutionStrategy": "Subdomain"
  },
  "Seeding": {
    "EnabledEnvironments": ["Development", "Staging"],
    "SeedData": true,
    "SeedUsers": true,
    "SeedTenants": true,
    "AdminUser": {
      "Email": "admin@nexora.com",
      "FirstName": "Admin",
      "LastName": "User",
      "Password": "${ADMIN_PASSWORD}"
    }
  },
  "Telemetry": {
    "ServiceName": "Nexora.Platform",
    "ServiceVersion": "1.0.0",
    "JaegerEndpoint": "http://localhost:14268/api/traces",
    "OtlpEndpoint": "http://localhost:4317",
    "PrometheusPort": 9090,
    "SamplingRatio": 0.1,
    "EnableMetrics": true,
    "EnableTracing": true,
    "EnableLogging": true
  },
  "Caching": {
    "DefaultExpirationMinutes": 30,
    "L1ExpirationMinutes": 5,
    "L1SlidingExpirationMinutes": 2,
    "L2SlidingExpirationMinutes": 10,
    "LockTimeoutSeconds": 30,
    "MaxLocks": 1000
  },
  "RateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "*/auth/*",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "*/payments",
        "Period": "1m",
        "Limit": 50
      }
    ]
  },
  "Security": {
    "EnableZeroTrust": true,
    "RequireMfaForHighRisk": true,
    "MaxFailedLoginAttempts": 5,
    "LockoutDurationMinutes": 30,
    "PasswordPolicy": {
      "MinLength": 8,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireDigit": true,
      "RequireSpecialChar": true
    }
  },
  "Performance": {
    "EnableResponseCaching": true,
    "CacheDurationSeconds": 300,
    "EnableCompression": true,
    "MaxConcurrentRequests": 1000
  },
  "Encryption": {
    "FieldKey": "${FIELD_ENCRYPTION_KEY}",
    "FieldIV": "${FIELD_ENCRYPTION_IV}"
  },
  "OpenAI": {
    "ApiKey": "${OPENAI_API_KEY}",
    "Model": "gpt-4",
    "MaxTokens": 1000,
    "Temperature": 0.7
  },
  "Fraud": {
    "EnableRealTimeDetection": true,
    "HighRiskThreshold": 0.8,
    "MediumRiskThreshold": 0.4,
    "EnableMachineLearning": true,
    "ModelUpdateIntervalHours": 24
  },
  "PaymentSecurity": {
    "EnableGeographicRestrictions": true,
    "BlockedCountries": [ "AF", "IR", "KP", "SY", "YE" ],
    "AllowedCountries": [ "SA", "AE", "KW", "QA", "BH", "OM", "US", "GB", "DE", "FR", "CA", "AU" ],
    "VelocityLimits": {
      "HourlyPaymentCount": 5,
      "HourlyPaymentAmount": 25000,
      "DailyPaymentCount": 20,
      "DailyPaymentAmount": 100000,
      "MaxFailedAttempts": 3
    },
    "PciCompliance": {
      "RequireIdempotencyKey": true,
      "MaxPaymentAmount": 100000,
      "TrustedProviders": [ "stripe", "paypal", "mada", "hyperpay" ],
      "EnableCardTokenization": true,
      "RequireSecureTransmission": true
    },
    "CardSecurity": {
      "EnableBinValidation": true,
      "BlockTestCards": true,
      "RequireCvvValidation": true,
      "EnableCardTestingDetection": true,
      "MaxNewCardAttempts": 3
    },
    "BusinessHours": {
      "StartHour": 8,
      "EndHour": 22,
      "Timezone": "Asia/Riyadh",
      "EnableOffHoursRestrictions": false
    }
  },
  "Compliance": {
    "EnableGdpr": true,
    "DataRetentionDays": 2555,
    "EnableAuditLogging": true,
    "RequireConsentForAnalytics": true
  },
  "PasswordHashing": {
    "Argon2": {
      "MemoryCost": 65536,
      "TimeCost": 3,
      "Parallelism": 1,
      "HashLength": 32,
      "SaltLength": 16
    }
  }
}

