{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=NexoraDb;User Id=${DB_USER};Password=${DB_PASSWORD};TrustServerCertificate=True;"
  },
  "Redis": {
    "ConnectionString": "${REDIS_CONNECTION_STRING}",
    "InstanceName": "nexora:"
  },
  "KeyVault": {
    "VaultUri": "https://${KEY_VAULT_NAME}.vault.azure.net/",
    "CurrentKeyId": "${CURRENT_KEY_ID}",
    "PreviousKeyIds": [
      "${PREVIOUS_KEY_ID_1}",
      "${PREVIOUS_KEY_ID_2}"
    ]
  },
  "Jwt": {
    "Issuer": "nexora-api",
    "Audience": "nexora-clients",
    "Key": "${JWT_SECRET}",
    "ExpiryInMinutes": 60
  },
  "Tenancy": {
    "Mode": "Subdomain", // Subdomain or Header
    "HeaderName": "X-Tenant-ID",
    "DefaultTenantId": 1
  },
  "Seeding": {
    "EnabledEnvironments": ["Development", "Staging"], // Prevent seeders from running in PROD
    "AdminUser": {
      "Email": "admin@nexora.com",
      "FirstName": "Admin",
      "LastName": "User",
      "Password": "${ADMIN_PASSWORD}"
    }
  }
}

