{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Nexora": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=NexoraDb;User Id=${DB_USER};Password=${DB_PASSWORD};TrustServerCertificate=True;",
    "Redis": "${REDIS_CONNECTION_STRING}"
  },
  "KeyVault": {
    "VaultUri": "https://${KEY_VAULT_NAME}.vault.azure.net/",
    "CurrentKeyId": "${CURRENT_KEY_ID}",
    "PreviousKeyIds": [
      "${PREVIOUS_KEY_ID_1}",
      "${PREVIOUS_KEY_ID_2}"
    ]
  },
  "Jwt": {
    "Issuer": "nexora.sa-api",
    "Audience": "nexora.sa-clients",
    "SecretKey": "${JWT_SECRET}",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30
  },
  "Tenancy": {
    "Mode": "Subdomain",
    "HeaderName": "X-Tenant-ID",
    "DefaultTenantId": 1,
    "EnableMultiTenancy": true,
    "TenantResolutionStrategy": "Subdomain"
  },
  "Seeding": {
    "EnabledEnvironments": ["Development", "Staging"],
    "SeedData": true,
    "SeedUsers": true,
    "SeedTenants": true,
    "AdminUser": {
      "Email": "admin@nexora.sa",
      "FirstName": "Admin",
      "LastName": "User",
      "Password": "${ADMIN_PASSWORD}"
    }
  },
  "Telemetry": {
    "ServiceName": "Nexora.Platform",
    "ServiceVersion": "1.0.0",
    "JaegerEndpoint": "http://localhost:14268/api/traces",
    "OtlpEndpoint": "http://localhost:4317",
    "PrometheusPort": 9090,
    "SamplingRatio": 0.1,
    "EnableMetrics": true,
    "EnableTracing": true,
    "EnableLogging": true
  },
  "Caching": {
    "DefaultExpirationMinutes": 30,
    "L1ExpirationMinutes": 5,
    "L1SlidingExpirationMinutes": 2,
    "L2SlidingExpirationMinutes": 10,
    "LockTimeoutSeconds": 30,
    "MaxLocks": 1000
  },
  "RateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "*/auth/*",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "*/payments",
        "Period": "1m",
        "Limit": 50
      }
    ]
  },
  "Security": {
    "EnableZeroTrust": true,
    "RequireMfaForHighRisk": true,
    "MaxFailedLoginAttempts": 5,
    "LockoutDurationMinutes": 30,
    "PasswordPolicy": {
      "MinLength": 8,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireDigit": true,
      "RequireSpecialChar": true
    }
  },
  "Performance": {
    "EnableResponseCaching": true,
    "CacheDurationSeconds": 300,
    "EnableCompression": true,
    "MaxConcurrentRequests": 1000
  },
  "Encryption": {
    "FieldKey": "${FIELD_ENCRYPTION_KEY}",
    "FieldIV": "${FIELD_ENCRYPTION_IV}"
  },
  "OpenAI": {
    "ApiKey": "${OPENAI_API_KEY}",
    "Model": "gpt-4",
    "MaxTokens": 1000,
    "Temperature": 0.7
  },
  "Fraud": {
    "EnableRealTimeDetection": true,
    "HighRiskThreshold": 0.8,
    "MediumRiskThreshold": 0.4,
    "EnableMachineLearning": true,
    "ModelUpdateIntervalHours": 24
  },
  "PaymentSecurity": {
    "EnableGeographicRestrictions": true,
    "BlockedCountries": [ "AF", "IR", "KP", "SY", "YE" ],
    "AllowedCountries": [ "SA", "AE", "KW", "QA", "BH", "OM", "US", "GB", "DE", "FR", "CA", "AU" ],
    "VelocityLimits": {
      "HourlyPaymentCount": 5,
      "HourlyPaymentAmount": 25000,
      "DailyPaymentCount": 20,
      "DailyPaymentAmount": 100000,
      "MaxFailedAttempts": 3
    },
    "PciCompliance": {
      "RequireIdempotencyKey": true,
      "MaxPaymentAmount": 100000,
      "TrustedProviders": [ "stripe", "paypal", "mada", "hyperpay" ],
      "EnableCardTokenization": true,
      "RequireSecureTransmission": true
    },
    "CardSecurity": {
      "EnableBinValidation": true,
      "BlockTestCards": true,
      "RequireCvvValidation": true,
      "EnableCardTestingDetection": true,
      "MaxNewCardAttempts": 3
    },
    "BusinessHours": {
      "StartHour": 8,
      "EndHour": 22,
      "Timezone": "Asia/Riyadh",
      "EnableOffHoursRestrictions": false
    }
  },
  "Compliance": {
    "EnableGdpr": true,
    "DataRetentionDays": 2555,
    "EnableAuditLogging": true,
    "RequireConsentForAnalytics": true
  },
  "PasswordHashing": {
    "Argon2": {
      "MemoryCost": 65536,
      "TimeCost": 3,
      "Parallelism": 1,
      "HashLength": 32,
      "SaltLength": 16
    }
  },
  "Fintech": {
    "PaymentProviders": {
      "DefaultProvider": "stripe",
      "EnableFailover": true,
      "FailoverTimeoutSeconds": 30,
      "EnableLoadBalancing": false,
      "Providers": {
        "stripe": {
          "Name": "Stripe",
          "ApiKey": "${STRIPE_API_KEY}",
          "ApiSecret": "${STRIPE_API_SECRET}",
          "BaseUrl": "https://api.stripe.com",
          "IsEnabled": true,
          "IsTestMode": false,
          "MaxTransactionAmount": 100000,
          "MinTransactionAmount": 1,
          "SupportedCurrencies": ["SAR", "USD", "EUR", "GBP", "AED"],
          "SupportedCountries": ["SA", "AE", "KW", "QA", "BH", "OM", "US", "GB", "DE", "FR"],
          "Fees": {
            "FixedFee": 0,
            "PercentageFee": 2.9,
            "InternationalFee": 1.5
          }
        },
        "paypal": {
          "Name": "PayPal",
          "ApiKey": "${PAYPAL_CLIENT_ID}",
          "ApiSecret": "${PAYPAL_CLIENT_SECRET}",
          "BaseUrl": "https://api.paypal.com",
          "IsEnabled": true,
          "IsTestMode": false,
          "MaxTransactionAmount": 50000,
          "MinTransactionAmount": 1,
          "SupportedCurrencies": ["SAR", "USD", "EUR", "GBP"],
          "SupportedCountries": ["SA", "AE", "US", "GB", "DE", "FR"],
          "Fees": {
            "FixedFee": 0,
            "PercentageFee": 3.4,
            "InternationalFee": 2.0
          }
        },
        "mada": {
          "Name": "Mada",
          "ApiKey": "${MADA_API_KEY}",
          "ApiSecret": "${MADA_API_SECRET}",
          "BaseUrl": "https://api.mada.com.sa",
          "IsEnabled": true,
          "IsTestMode": false,
          "MaxTransactionAmount": 200000,
          "MinTransactionAmount": 1,
          "SupportedCurrencies": ["SAR"],
          "SupportedCountries": ["SA"],
          "Fees": {
            "FixedFee": 0,
            "PercentageFee": 1.75,
            "InternationalFee": 0
          }
        },
        "hyperpay": {
          "Name": "HyperPay",
          "ApiKey": "${HYPERPAY_API_KEY}",
          "ApiSecret": "${HYPERPAY_API_SECRET}",
          "BaseUrl": "https://api.hyperpay.com",
          "IsEnabled": true,
          "IsTestMode": false,
          "MaxTransactionAmount": 150000,
          "MinTransactionAmount": 1,
          "SupportedCurrencies": ["SAR", "AED", "KWD", "QAR", "BHD", "OMR"],
          "SupportedCountries": ["SA", "AE", "KW", "QA", "BH", "OM"],
          "Fees": {
            "FixedFee": 0,
            "PercentageFee": 2.5,
            "InternationalFee": 1.0
          }
        }
      }
    },
    "SmsPricing": {
      "DefaultCurrency": "SAR",
      "EnableDynamicPricing": true,
      "MarkupPercentage": 15,
      "PricingTiers": {
        "starter": {
          "Name": "Starter",
          "MinVolume": 1,
          "MaxVolume": 1000,
          "PricePerMessage": 0.15,
          "Currency": "SAR",
          "MessageTypePricing": {
            "transactional": 0.15,
            "promotional": 0.12,
            "otp": 0.18
          },
          "ChannelPricing": {
            "sms": 0.15,
            "whatsapp": 0.25,
            "rcs": 0.30
          }
        },
        "business": {
          "Name": "Business",
          "MinVolume": 1001,
          "MaxVolume": 10000,
          "PricePerMessage": 0.12,
          "Currency": "SAR",
          "MessageTypePricing": {
            "transactional": 0.12,
            "promotional": 0.10,
            "otp": 0.15
          },
          "ChannelPricing": {
            "sms": 0.12,
            "whatsapp": 0.22,
            "rcs": 0.27
          }
        },
        "enterprise": {
          "Name": "Enterprise",
          "MinVolume": 10001,
          "MaxVolume": 100000,
          "PricePerMessage": 0.08,
          "Currency": "SAR",
          "MessageTypePricing": {
            "transactional": 0.08,
            "promotional": 0.07,
            "otp": 0.10
          },
          "ChannelPricing": {
            "sms": 0.08,
            "whatsapp": 0.18,
            "rcs": 0.22
          }
        }
      },
      "CountryPricing": {
        "SA": {
          "CountryCode": "SA",
          "CountryName": "Saudi Arabia",
          "BasePrice": 0.12,
          "Currency": "SAR",
          "OperatorPrices": {
            "STC": 0.10,
            "Mobily": 0.12,
            "Zain": 0.11,
            "Virgin": 0.13
          },
          "IsHighRisk": false,
          "RiskMultiplier": 1.0
        },
        "AE": {
          "CountryCode": "AE",
          "CountryName": "United Arab Emirates",
          "BasePrice": 0.18,
          "Currency": "SAR",
          "OperatorPrices": {
            "Etisalat": 0.16,
            "Du": 0.18,
            "Virgin": 0.20
          },
          "IsHighRisk": false,
          "RiskMultiplier": 1.0
        },
        "KW": {
          "CountryCode": "KW",
          "CountryName": "Kuwait",
          "BasePrice": 0.22,
          "Currency": "SAR",
          "OperatorPrices": {
            "Zain": 0.20,
            "Ooredoo": 0.22,
            "Viva": 0.24
          },
          "IsHighRisk": false,
          "RiskMultiplier": 1.0
        }
      },
      "VolumeDiscounts": {
        "EnableAutoUpgrade": true,
        "EvaluationPeriodDays": 30,
        "Tiers": [
          {
            "MinVolume": 5000,
            "DiscountPercentage": 5,
            "Description": "5% discount for 5K+ messages"
          },
          {
            "MinVolume": 25000,
            "DiscountPercentage": 10,
            "Description": "10% discount for 25K+ messages"
          },
          {
            "MinVolume": 100000,
            "DiscountPercentage": 15,
            "Description": "15% discount for 100K+ messages"
          },
          {
            "MinVolume": 500000,
            "DiscountPercentage": 20,
            "Description": "20% discount for 500K+ messages"
          }
        ]
      }
    },
    "CurrencyExchange": {
      "PrimaryProvider": "exchangerate-api",
      "FallbackProviders": ["fixer", "currencylayer"],
      "CacheExpirationMinutes": 60,
      "MaxExchangeRateAge": 24,
      "EnableRealTimeRates": true,
      "BaseCurrency": "SAR",
      "SupportedCurrencies": ["SAR", "USD", "EUR", "GBP", "AED", "KWD", "QAR", "BHD", "OMR", "JPY", "CAD", "AUD"],
      "Providers": {
        "exchangerate-api": {
          "Name": "ExchangeRate-API",
          "ApiKey": "${EXCHANGE_RATE_API_KEY}",
          "BaseUrl": "https://v6.exchangerate-api.com/v6",
          "IsEnabled": true,
          "Priority": 1,
          "RateLimit": 1500
        },
        "fixer": {
          "Name": "Fixer.io",
          "ApiKey": "${FIXER_API_KEY}",
          "BaseUrl": "https://api.fixer.io",
          "IsEnabled": true,
          "Priority": 2,
          "RateLimit": 1000
        },
        "currencylayer": {
          "Name": "CurrencyLayer",
          "ApiKey": "${CURRENCYLAYER_API_KEY}",
          "BaseUrl": "https://api.currencylayer.com",
          "IsEnabled": true,
          "Priority": 3,
          "RateLimit": 1000
        }
      }
    },
    "FraudDetection": {
      "EnableRealTimeDetection": true,
      "EnableMachineLearning": true,
      "ModelUpdateIntervalHours": 24,
      "Thresholds": {
        "HighRiskThreshold": 0.8,
        "MediumRiskThreshold": 0.4,
        "LowRiskThreshold": 0.2,
        "AutoBlockThreshold": 0.95,
        "ManualReviewThreshold": 0.7,
        "CountryRiskThresholds": {
          "AF": 0.9,
          "IR": 0.9,
          "KP": 0.95,
          "SY": 0.9,
          "YE": 0.85
        },
        "PaymentMethodThresholds": {
          "CreditCard": 0.6,
          "DebitCard": 0.5,
          "BankTransfer": 0.3,
          "DigitalWallet": 0.4
        }
      },
      "Rules": {
        "Velocity": {
          "MaxTransactionsPerHour": 10,
          "MaxAmountPerHour": 50000,
          "MaxTransactionsPerDay": 50,
          "MaxAmountPerDay": 200000,
          "MaxFailedAttemptsPerHour": 5,
          "PaymentMethodLimits": {
            "CreditCard": {
              "MaxTransactions": 15,
              "MaxAmount": 75000,
              "TimeWindowMinutes": 60
            },
            "DebitCard": {
              "MaxTransactions": 20,
              "MaxAmount": 50000,
              "TimeWindowMinutes": 60
            }
          }
        },
        "Geographic": {
          "BlockedCountries": ["AF", "IR", "KP", "SY", "YE"],
          "HighRiskCountries": ["PK", "BD", "NG", "GH"],
          "EnableVpnDetection": true,
          "BlockTorTraffic": true,
          "CountryMismatchRiskScore": 0.3
        },
        "Behavioral": {
          "EnableUserBehaviorAnalysis": true,
          "UnusualPatternThreshold": 0.5,
          "MinHistoryDays": 7,
          "BehaviorWeights": {
            "TimeOfDay": 0.1,
            "DayOfWeek": 0.1,
            "AmountPattern": 0.3,
            "FrequencyPattern": 0.2,
            "LocationPattern": 0.3
          }
        },
        "Device": {
          "EnableDeviceFingerprinting": true,
          "BlockEmulators": true,
          "RequireDeviceRegistration": false,
          "NewDeviceRiskScore": 0.2,
          "MaxDevicesPerUser": 5
        }
      },
      "Notifications": {
        "EnableEmailNotifications": true,
        "EnableSmsNotifications": false,
        "EnableWebhookNotifications": true,
        "NotificationEmails": ["security@nexora.com", "admin@nexora.com"],
        "WebhookUrl": "${FRAUD_WEBHOOK_URL}",
        "NotificationTypes": {
          "HighRiskTransaction": true,
          "BlockedTransaction": true,
          "SuspiciousPattern": true,
          "VelocityViolation": true
        }
      },
      "RiskWeights": {
        "Geographic": 0.25,
        "Velocity": 0.30,
        "Behavioral": 0.20,
        "Device": 0.15,
        "PaymentMethod": 0.10
      }
    },
    "Compliance": {
      "EnableGdprCompliance": true,
      "EnablePciCompliance": true,
      "EnableKsaCompliance": true,
      "DataRetentionDays": 2555,
      "EnableAuditLogging": true,
      "RequireConsentForAnalytics": true,
      "Rules": {
        "GDPR": {
          "Name": "General Data Protection Regulation",
          "Description": "EU data protection regulation",
          "IsEnabled": true,
          "Jurisdiction": "EU",
          "Parameters": {
            "ConsentRequired": true,
            "DataPortabilityEnabled": true,
            "RightToErasureEnabled": true
          }
        },
        "PCI_DSS": {
          "Name": "Payment Card Industry Data Security Standard",
          "Description": "Security standard for payment card data",
          "IsEnabled": true,
          "Jurisdiction": "Global",
          "Parameters": {
            "EncryptionRequired": true,
            "TokenizationEnabled": true,
            "AuditLoggingRequired": true
          }
        },
        "KSA_SAMA": {
          "Name": "Saudi Arabian Monetary Authority Regulations",
          "Description": "KSA financial services regulations",
          "IsEnabled": true,
          "Jurisdiction": "SA",
          "Parameters": {
            "LocalDataStorage": true,
            "ComplianceReporting": true,
            "KycRequired": true
          }
        }
      }
    },
    "Billing": {
      "DefaultCurrency": "SAR",
      "DefaultBillingCycle": "Monthly",
      "EnableAutomaticBilling": true,
      "PaymentTermsDays": 30,
      "LateFeePercentage": 5,
      "EnableVolumeDiscounts": true,
      "TaxRates": {
        "SA": 15,
        "AE": 5,
        "KW": 0,
        "QA": 0,
        "BH": 10,
        "OM": 5
      },
      "Invoice": {
        "CompanyName": "Nexora Platform",
        "CompanyAddress": "Riyadh, Saudi Arabia",
        "TaxId": "${COMPANY_TAX_ID}",
        "LogoUrl": "https://nexora.com/logo.png",
        "EnableWhiteLabel": true,
        "CustomFields": {
          "SupportEmail": "support@nexora.com",
          "SupportPhone": "+966-11-123-4567"
        }
      }
    }
  }
}

